<?xml version="1.0" encoding="utf-8"?><!--
   Note text is encrypted with a device bound Android Keystore key, so an auto backup copy of the
   note database could never be decrypted on another device. Notes travel with the app's own
   Backup / Restore feature (Settings -> Cloud), which stores the database in a portable form.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="note-list.db" />
        <exclude domain="database" path="note-list.db-wal" />
        <exclude domain="database" path="note-list.db-shm" />
        <!-- EncryptedSharedPreferences cannot be decrypted after the Keystore key is lost. -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
        <!-- The database is excluded above, so restored media would arrive with no note pointing
             at it. Leaving it out also keeps the backup small. -->
        <exclude domain="file" path="audios/" />
        <exclude domain="file" path="attachments/" />
        <exclude domain="file" path="BackupFolder/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="note-list.db" />
        <exclude domain="database" path="note-list.db-wal" />
        <exclude domain="database" path="note-list.db-shm" />
        <!-- A device transfer also moves to new hardware, where the Keystore key is unavailable. -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="audios/" />
        <exclude domain="file" path="attachments/" />
        <exclude domain="file" path="BackupFolder/" />
    </device-transfer>
</data-extraction-rules>