<?xml version="1.0" encoding="utf-8"?><!--
   Note text is encrypted with a device bound Android Keystore key, so an auto backup copy of the
   note database could never be decrypted on another device. Notes travel with the app's own
   Backup / Restore feature (Settings -> Cloud), which stores the database in a portable form.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <!-- EncryptedSharedPreferences cannot be decrypted after the Keystore key is lost. -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
        <!-- The database is excluded above, so restored media would arrive with no note pointing
             at it. Leaving it out also keeps the backup small. -->
        <exclude domain="file" path="audios/" />
        <exclude domain="file" path="attachments/" />
        <!-- Reconcile parks orphaned media here rather than deleting it, so the bytes are intact.
             Nothing on another device could ever reference them, and they are the media the user
             believes was removed. -->
        <exclude domain="file" path="attachments-quarantine/" />
        <exclude domain="file" path="BackupFolder/" />
        <!-- Glance widget state (files/glance/widget-state/) maps appWidgetId -> note id and holds
             no note text today, but this is a negative list: any new files/ subdirectory travels
             with a backup by default. Keep it out before widget state starts holding note content. -->
        <exclude domain="file" path="glance/" />
        <!-- Custom note fonts (files/fonts/) are downloaded, not authored: a backup would only
             carry them to a device that can fetch them again. This is a negative list, so they
             leave the device unless named here. -->
        <exclude domain="file" path="fonts/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <!-- A device transfer also moves to new hardware, where the Keystore key is unavailable. -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="audios/" />
        <exclude domain="file" path="attachments/" />
        <!-- A device transfer also moves to new hardware, where the quarantine's bytes could never
             be matched to a note row. Once here, they must not ride along either. -->
        <exclude domain="file" path="attachments-quarantine/" />
        <exclude domain="file" path="BackupFolder/" />
        <!-- Same negative-list reasoning as above: widget state must not ride along to a new
             device either. -->
        <exclude domain="file" path="glance/" />
        <!-- Same negative-list reasoning as in cloud-backup: a transferred font would only be
             re-fetched, and an unnamed directory rides along by default. -->
        <exclude domain="file" path="fonts/" />
    </device-transfer>
</data-extraction-rules>