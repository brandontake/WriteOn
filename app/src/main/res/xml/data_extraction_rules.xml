<?xml version="1.0" encoding="utf-8"?><!--
   Note text is encrypted with a device bound Android Keystore key, so an auto backup copy of the
   note database could never be decrypted on another device. Notes travel with the app's own
   Backup / Restore feature (Settings -> Cloud), which stores the database in a portable form.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="note-list.db" />
        <exclude domain="database" path="note-list.db-wal" />
        <exclude domain="database" path="note-list.db-shm" />
        <!-- The database is excluded above, so restored recordings would arrive with no note
             pointing at them. Leaving them out also keeps the backup small, since voice memos
             dominate it. -->
        <exclude domain="file" path="audios/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="note-list.db" />
        <exclude domain="database" path="note-list.db-wal" />
        <exclude domain="database" path="note-list.db-shm" />
        <exclude domain="file" path="audios/" />
    </device-transfer>
</data-extraction-rules>